# 本地开发用的环境变量（请勿提交真实密钥！）
# 复制本文件为 .dev.vars 并填入你的值：
#   cp .dev.vars.example .dev.vars
#
# 说明：
# - GITHUB_TOKEN 需要 repo（私有库）或 public_repo（公开库）权限，用于读写 Firefly 仓库内容
# - ADMIN_PASSWORD 是登录本管理后台的密码
# - GH_OWNER / GH_REPO / GH_BRANCH 指向你的 Firefly 内容仓库

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_PASSWORD=change_me_strong_password
GH_OWNER=slepoh
GH_REPO=Firefly
GH_BRANCH=master
